<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    x:Class="SeattleCarsInBikeLanes.Mobile.Resources.Styles.Material3Colors"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="M3Primary">#235CB1</Color>
    <Color x:Key="M3OnPrimary">#FFFFFF</Color>
    <Color x:Key="M3PrimaryContainer">#D7E2FF</Color>
    <Color x:Key="M3OnPrimaryContainer">#001A40</Color>

    <Color x:Key="M3Secondary">#565E71</Color>
