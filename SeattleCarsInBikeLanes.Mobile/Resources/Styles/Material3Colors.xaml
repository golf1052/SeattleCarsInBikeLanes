<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    x:Class="SeattleCarsInBikeLanes.Mobile.Resources.Styles.Material3Colors"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="M3Primary">#5F3DE2</Color>
    <Color x:Key="M3OnPrimary">#FFFFFF</Color>
    <Color x:Key="M3PrimaryContainer">#E6DEFF</Color>
    <Color x:Key="M3OnPrimaryContainer">#1B0063</Color>

    <Color x:Key="M3Secondary">#605C71</Color>
