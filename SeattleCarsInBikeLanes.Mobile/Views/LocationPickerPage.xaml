<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="SeattleCarsInBikeLanes.Mobile.Views.LocationPickerPage"
             Title="Pick the location">

    <Grid RowDefinitions="Auto, *, Auto">
        <Label Grid.Row="0"
               Text="Tap the map where this happened."
               Padding="16,12" />

        <maps:Map x:Name="Map" Grid.Row="1" />

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Padding="16" ColumnSpacing="12">
            <Button Grid.Column="0" Text="Cancel" Clicked="CancelClicked" />
            <Button Grid.Column="1" x:Name="UseButton" Text="Use this location" IsEnabled="False" Clicked="UseClicked" />
        </Grid>
    </Grid>
</ContentPage>
