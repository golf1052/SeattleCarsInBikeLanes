<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeattleCarsInBikeLanes.Mobile.Views.LoginPage"
             Title="Sign in">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="16,12" Spacing="8">
            <Label Text="Sign in so the reports you send can be credited to you." />

            <!-- The site keeps these behind a collapsed navbar dropdown, which is awkward on a
                 phone, so the app offers them directly and drives the site's own dialogs. -->
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="BlueskyButton" Text="Bluesky" Clicked="BlueskyClicked" />
                <Button x:Name="MastodonButton" Text="Mastodon" Clicked="MastodonClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <WebView x:Name="Web" Grid.Row="1" Navigated="WebNavigated" />

        <ActivityIndicator Grid.Row="1"
                           x:Name="Busy"
                           IsRunning="True"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>
</ContentPage>
